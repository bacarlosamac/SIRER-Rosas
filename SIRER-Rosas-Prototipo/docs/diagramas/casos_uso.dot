digraph G {graph[rankdir=LR,bgcolor="white",pad=.3,ranksep=.7,nodesep=.37];node[fontname="DejaVu Sans",fontsize=10];edge[dir=none,color="#6b8c82"];comunidad[shape=box,style="rounded,filled",fillcolor="#dcefe5",label="Actor:\nComunidad"];gestor[shape=box,style="rounded,filled",fillcolor="#dcefe5",label="Actor:\nGestor"];subgraph cluster_app {label="SIRER-Rosas";style="rounded";color="#b3cec2";node[shape=ellipse,style=filled,fillcolor="#f2f7f5",color="#b5cfc4"];login[label="Autenticarse"];crear[label="Crear reporte"];subir[label="Adjuntar evidencia"];mapa[label="Consultar mapa"];filtrar[label="Filtrar e histórico"];actualizar[label="Actualizar estado"];auditar[label="Consultar trazabilidad"];};comunidad->login;comunidad->crear;comunidad->subir;comunidad->mapa;comunidad->filtrar;gestor->login;gestor->mapa;gestor->actualizar;gestor->auditar;}
